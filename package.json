{
  "name": "sodax-leverage-yield-starter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Whitelabel React starter for building SODAX Leverage Yield (lsoda* ERC-4626 vaults) with coding agents.",
  "license": "MIT",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "tsc --noEmit && biome check . && tsx scripts/check-versions.ts && tsx scripts/check-format.ts",
    "preflight": "tsx scripts/preflight.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.2.8",
    "@fontsource-variable/oswald": "5.2.8",
    "@fontsource-variable/public-sans": "5.2.7",
    "@fontsource/inria-serif": "5.2.8",
    "@fontsource/shrikhand": "5.2.8",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-dropdown-menu": "2.1.16",
    "@radix-ui/react-select": "2.2.6",
    "@radix-ui/react-slot": "1.2.3",
    "@radix-ui/react-tooltip": "1.2.8",
    "@sodax/dapp-kit": "2.2.0-rc.8",
    "@sodax/sdk": "2.2.0-rc.8",
    "@sodax/types": "2.2.0-rc.8",
    "@sodax/wallet-sdk-react": "2.2.0-rc.8",
    "@tanstack/react-query": "5.87.4",
    "buffer": "6.0.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "0.456.0",
    "react": "19.1.4",
    "react-dom": "19.1.4",
    "sonner": "2.0.7",
    "tailwind-merge": "3.3.1",
    "viem": "2.29.2",
    "wagmi": "2.16.9"
  },
  "devDependencies": {
    "@bangjelkoski/vite-plugin-node-polyfills": "0.0.2",
    "@biomejs/biome": "2.5.14",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.18.1",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.1.4",
    "tailwindcss": "4.3.3",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vite": "7.3.6"
  }
}
